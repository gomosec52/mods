{
  "namespace": "server_form",

  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'kdm:') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "custom_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'kdm:') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "kdm_long_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "server_form.kdm_title_panel",
    "$title_size": ["100% - 20px", 24],
    "$title_max_size": ["100% - 20px", 24],
    "size": [450, 520],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.kdm_content_panel",
    "$custom_background": "server_form.kdm_dialog_bg",
    "$show_close_button": true,
    "layer": 3,
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_name": "#form_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'kdm:') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "kdm_custom_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "server_form.kdm_title_panel",
    "$title_size": ["100% - 20px", 24],
    "$title_max_size": ["100% - 20px", 24],
    "size": [450, 300],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.custom_form_panel",
    "$custom_background": "server_form.kdm_dialog_bg",
    "$show_close_button": true,
    "layer": 3,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'kdm:') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "kdm_dialog_bg": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "shadow": {
          "type": "image",
          "texture": "textures/ui/kingdoms/menu_shadow",
          "size": ["100%", "100%"],
          "offset": [5, 6],
          "alpha": 0.55,
          "layer": 1
        }
      },
      {
        "parchment": {
          "type": "image",
          "texture": "textures/ui/kingdoms/menu_parchment",
          "size": ["100%", "100%"],
          "nineslice_size": [56, 56, 56, 56],
          "uv_size": [512, 512],
          "layer": 2
        }
      }
    ]
  },

  "kdm_title_panel": {
    "type": "panel",
    "size": ["100%", "100%"],
    "bindings": [
      { "binding_name": "#title_text" }
    ],
    "controls": [
      {
        "title@server_form.kdm_title_label": {}
      }
    ]
  },

  "kdm_title_label": {
    "type": "label",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [0, 2],
    "size": ["100%", "default"],
    "text_alignment": "center",
    "color": [0.32, 0.16, 0.05, 1.0],
    "font_scale_factor": 1.1,
    "shadow": false,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text - 'kdm:')",
        "target_property_name": "#text"
      }
    ]
  },

  "kdm_content_panel": {
    "type": "stack_panel",
    "size": ["100% - 36px", "100% - 34px"],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [0, 6],
    "bindings": [
      { "binding_name": "#form_text" },
      { "binding_name": "#title_text" }
    ],
    "controls": [
      {
        "banner": {
          "type": "image",
          "texture": "textures/ui/kingdoms/menu_banner",
          "size": [260, 36],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "alpha": 0.95
        }
      },
      {
        "council_row": {
          "type": "stack_panel",
          "size": ["100%", "fill"],
          "orientation": "horizontal",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {
              "stats_panel": {
                "type": "stack_panel",
                "size": [238, "100%"],
                "offset": [0, 8],
                "orientation": "vertical",
                "collection_name": "form_buttons",
                "controls": [
                  { "stat_0@server_form.kdm_stat_line": { "collection_index": 0 } },
                  { "stat_1@server_form.kdm_stat_line": { "collection_index": 1 } },
                  { "stat_2@server_form.kdm_stat_line": { "collection_index": 2 } },
                  { "stat_3@server_form.kdm_stat_line": { "collection_index": 3 } },
                  { "stat_4@server_form.kdm_stat_line": { "collection_index": 4 } },
                  { "stat_5@server_form.kdm_stat_line": { "collection_index": 5 } },
                  { "stat_6@server_form.kdm_stat_line": { "collection_index": 6 } },
                  { "stat_7@server_form.kdm_stat_line": { "collection_index": 7 } },
                  { "stat_8@server_form.kdm_stat_line": { "collection_index": 8 } },
                  { "stat_9@server_form.kdm_stat_line": { "collection_index": 9 } },
                  { "stat_10@server_form.kdm_stat_line": { "collection_index": 10 } },
                  { "stat_11@server_form.kdm_stat_line": { "collection_index": 11 } },
                  { "stat_12@server_form.kdm_stat_line": { "collection_index": 12 } },
                  { "stat_13@server_form.kdm_stat_line": { "collection_index": 13 } }
                ]
              }
            },
            {
              "divider": {
                "type": "image",
                "texture": "textures/ui/kingdoms/menu_ornament",
                "size": [8, "100%"],
                "alpha": 0.55
              }
            },
            {
              "actions_panel": {
                "type": "panel",
                "size": [168, "100%"],
                "controls": [
                  {
                    "actions_stack": {
                      "type": "stack_panel",
                      "size": [150, "100%c"],
                      "offset": [0, 10],
                      "orientation": "vertical",
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle",
                      "collection_name": "form_buttons",
                      "controls": [
                        { "action_0@server_form.kdm_dynamic_button": { "collection_index": 14 } },
                        { "action_1@server_form.kdm_dynamic_button": { "collection_index": 15 } },
                        { "action_2@server_form.kdm_dynamic_button": { "collection_index": 16 } },
                        { "action_3@server_form.kdm_dynamic_button": { "collection_index": 17 } },
                        { "action_4@server_form.kdm_dynamic_button": { "collection_index": 18 } },
                        { "action_5@server_form.kdm_dynamic_button": { "collection_index": 19 } },
                        { "action_6@server_form.kdm_dynamic_button": { "collection_index": 20 } },
                        { "action_7@server_form.kdm_dynamic_button": { "collection_index": 21 } },
                        { "action_8@server_form.kdm_dynamic_button": { "collection_index": 22 } },
                        { "action_9@server_form.kdm_dynamic_button": { "collection_index": 23 } }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "kdm_stat_line": {
    "type": "label",
    "size": [228, 20],
    "offset": [8, 0],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text_alignment": "left",
    "color": [0.11, 0.055, 0.012, 1.0],
    "font_scale_factor": 0.82,
    "shadow": false,
    "text": "",
    "layer": 10,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons",
        "binding_name_override": "#text"
      }
    ]
  },

  "kdm_dynamic_button": {
    "type": "stack_panel",
    "size": [150, 28],
    "orientation": "horizontal",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons",
        "binding_name_override": "#kdm_button_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#kdm_button_text = ' '))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "form_button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "size": [144, 24],
          "offset": [0, 1],
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [132, 13],
          "$default_button_texture": "textures/ui/kingdoms/button_wood",
          "$hover_button_texture": "textures/ui/kingdoms/button_wood",
          "$pressed_button_texture": "textures/ui/kingdoms/button_danger",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  "kdm_buttons_panel": {
    "type": "stack_panel",
    "size": [150, "100%c"],
    "offset": [0, 6],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.kdm_dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "kdm_server_form_factory": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.kdm_long_form",
                  "custom_form": "@server_form.kdm_custom_form"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
