{
  "format_version": "1.8.0",
  "animations": {
    "animation.mannequin.base": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "math.sin(query.life_time * 1.6) * 1.2",
            "math.sin(query.life_time * 0.8) * 1.0",
            "math.sin(query.life_time * 2.0) * 0.7"
          ]
        }
      }
    },
    "animation.mannequin.move": {
      "loop": true,
      "anim_time_update": "query.modified_distance_moved * 30.0",
      "bones": {
        "rightArm": { "rotation": ["-math.sin(query.anim_time) * 58.0", 0, 0] },
        "leftArm": { "rotation": ["math.sin(query.anim_time) * 58.0", 0, 0] },
        "rightLeg": { "rotation": ["math.sin(query.anim_time) * 58.0", 0, 0] },
        "leftLeg": { "rotation": ["-math.sin(query.anim_time) * 58.0", 0, 0] }
      }
    },
    "animation.mannequin.look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "math.clamp(query.property('mannequin:head_pitch'), -75.0, 75.0)",
            "math.clamp(query.property('mannequin:head_yaw'), -80.0, 80.0)",
            0
          ]
        }
      }
    },
    "animation.mannequin.climb": {
      "loop": true,
      "anim_time_update": "query.life_time * 6.0",
      "bones": {
        "rightArm": { "rotation": ["-math.sin(query.anim_time) * 90.0", 0, 0] },
        "leftArm": { "rotation": ["math.sin(query.anim_time) * 90.0", 0, 0] },
        "rightLeg": { "rotation": ["math.sin(query.anim_time) * 48.0", 0, 0] },
        "leftLeg": { "rotation": ["-math.sin(query.anim_time) * 48.0", 0, 0] }
      }
    },
    "animation.mannequin.sneak": {
      "loop": true,
      "bones": {
        "body": { "rotation": [24.0, 0, 0], "position": [0, -2.5, 0] },
        "head": { "rotation": [-22.0, 0, 0] }
      }
    },
    "animation.mannequin.swim": {
      "loop": true,
      "anim_time_update": "query.life_time * 5.0",
      "bones": {
        "rightArm": { "rotation": ["math.sin(query.anim_time) * 65.0", 0, 8.0] },
        "leftArm": { "rotation": ["-math.sin(query.anim_time) * 65.0", 0, -8.0] },
        "rightLeg": { "rotation": ["-math.sin(query.anim_time) * 22.0", 0, 0] },
        "leftLeg": { "rotation": ["math.sin(query.anim_time) * 22.0", 0, 0] }
      }
    },
    "animation.mannequin.swing": {
      "loop": false,
      "animation_length": 0.3,
      "bones": {
        "rightArm": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.15": [-95, 0, 0],
            "0.3": [0, 0, 0]
          }
        }
      }
    }
  }
}
